@* ==================================== UPLOAD FORM ============================= *@
<div>
    <form asp-action="UploadVideo" enctype="multipart/form-data">
        <table style="background-color:saddlebrown; color:aliceblue; padding:10px;">
            <tr>
                <th colspan="2">Upload video</th>
            </tr>
            <tr>
                <th>Choose file:</th>
                <td id="uploadField"><input name="File" type="file" /></td>
            </tr>
            <tr>
                <th colspan="2" id="uploadButton">
                      <input type='submit' value='Upload' />  
                </th>
            </tr>
        </table>
    </form>
</div>

